model
  schema 1.2

type project # module: core, file: core.fga
  relations
    define editor: [user] or owner or member from program or manager from program or member from board
    define owner: [user] or manager from program
    define reviewer: ([user] and owner) or (member from program and auditor)
    define auditor: [user] or member from board # extended by: module: portfolio, file: portfolio.fga
    define program: [program] # extended by: module: portfolio, file: portfolio.fga
    define board: [board] # extended by: module: supervision, file: supervision.fga

type user # module: core, file: core.fga
  relations
    define delegate: [user] or deputy # extended by: module: supervision, file: supervision.fga
    define deputy: [user] # extended by: module: supervision, file: supervision.fga

type program # module: portfolio, file: portfolio.fga
  relations
    define manager: [user]
    define member: [user]

type board # module: supervision, file: supervision.fga
  relations
    define member: [user]
